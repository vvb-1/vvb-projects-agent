#!/usr/bin/env python3
"""vvb-projects — multi-host project hygiene for Vi Vet Bil AB.

Manages local repo clones, syncs from GitHub, scans for secrets, validates
structure, and reports to NTFY + Telegram. Stdlib only.

Subcommands
  sync      fetch + ff-merge origin/main on every tracked repo
  scan      secrets (.env, credentials, keys) — non-destructive report
  structure empty dirs / missing CLAUDE.md / duplicate clones
  fix       auto-apply safe non-breaking fixes (gitignore hints, prune dead)
  report    one-shot summary -> NTFY topic
  watch     long-running loop calling report every interval
  config    show / validate / edit config.yaml

All destructive operations (force-push, branch-delete, secret-redact) are
opt-in via config.yaml `auto_fix.breaking: true` and never run by default.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.request
import urllib.parse
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Iterable

VERSION = "0.1.0"
DEFAULT_CONFIG_LOCATIONS = [
    Path(os.environ.get("VVB_PROJECTS_CONFIG", "")),
    Path.home() / ".config" / "vvb-projects" / "config.yaml",
    Path.home() / ".vvb-projects.yaml",
    Path("/etc/vvb-projects/config.yaml"),
]


# ---------- config ----------

def load_config(path: Path | None) -> dict[str, Any]:
    """Load YAML config without PyYAML (we keep stdlib-only)."""
    import yaml  # type: ignore  # bundled with hermes-agent runtime
    if path is None:
        for loc in DEFAULT_CONFIG_LOCATIONS:
            if loc.exists():
                path = loc
                break
    if path is None or not path.exists():
        return {}
    with path.open(encoding="utf-8") as f:
        raw = yaml.safe_load(f) or {}
    return _defaults_overlay(raw)


def _defaults_overlay(cfg: dict[str, Any]) -> dict[str, Any]:
    """Apply defaults so missing keys still work."""
    cfg.setdefault("repos_dir", str(Path.home() / "Projects"))
    cfg.setdefault("controller_host", "calm-narwhal")
    cfg.setdefault("gh_org", "vvb-1")
    cfg.setdefault("auto_fix", {
        "safe": True,
        "breaking": False,  # default off — must be explicitly enabled
        "gitignore_add": True,
        "prune_empty_dirs": True,
        "dedup_clones": False,  # risky if repo names collide
        "secret_redact": False,
    })
    cfg.setdefault("scan", {
        "secret_patterns": True,
        "ignore_globs": [".git/**", "node_modules/**", ".venv/**", "dist/**"],
        "max_file_mb": 10,
    })
    cfg.setdefault("structure", {
        "require_claudemd": True,
        "require_changelogmd": False,
        "min_readme_bytes": 100,
    })
    cfg.setdefault("channels", {
        "ntfy": {"enabled": False, "topic": "", "server": "https://ntfy.sh"},
        "telegram": {"enabled": False, "chat_id": "", "bot_token_env": ""},
    })
    cfg.setdefault("watch_interval_sec", 3600)
    cfg.setdefault("state_db", str(Path.home() / ".local" / "share" / "vvb-projects" / "state.sqlite"))
    return cfg


# ---------- state ----------

def state_db_path(cfg: dict[str, Any]) -> Path:
    p = Path(cfg["state_db"])
    p.parent.mkdir(parents=True, exist_ok=True)
    return p


def init_state(db: Path) -> None:
    import sqlite3
    with sqlite3.connect(db) as c:
        c.executescript("""
        CREATE TABLE IF NOT EXISTS runs(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts TEXT NOT NULL,
            host TEXT NOT NULL,
            cmd TEXT NOT NULL,
            summary TEXT NOT NULL
        );
        CREATE TABLE IF NOT EXISTS findings(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts TEXT NOT NULL,
            host TEXT NOT NULL,
            repo TEXT,
            kind TEXT NOT NULL,
            severity TEXT NOT NULL,
            path TEXT,
            detail TEXT
        );
        CREATE INDEX IF NOT EXISTS findings_kind ON findings(kind);
        """)


def log_finding(db: Path, host: str, kind: str, severity: str, repo: str = "", path: str = "", detail: str = "") -> None:
    import sqlite3
    with sqlite3.connect(db) as c:
        c.execute(
            "INSERT INTO findings(ts,host,repo,kind,severity,path,detail) VALUES (?,?,?,?,?,?,?)",
            (datetime.now(timezone.utc).isoformat(), host, repo, kind, severity, path, detail),
        )


# ---------- discovery ----------

def list_tracked_repos(cfg: dict[str, Any]) -> list[Path]:
    base = Path(cfg["repos_dir"]).expanduser()
    if not base.exists():
        return []
    return sorted(p for p in base.iterdir() if (p / ".git").is_dir())


def gh_list_org_repos(org: str) -> list[str]:
    """Return names of every public+private repo in an org via `gh`."""
    try:
        out = subprocess.check_output(
            ["gh", "repo", "list", org, "--limit", "1000", "--json", "name", "-q", ".[] .name"],
            text=True, stderr=subprocess.DEVNULL, timeout=30,
        )
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return []
    return [n.strip() for n in out.splitlines() if n.strip()]


# ---------- scan: secrets ----------

SECRET_PATTERNS: list[tuple[str, re.Pattern[str]]] = [
    ("aws-access-key", re.compile(r"AKIA[0-9A-Z]{16}")),
    ("aws-secret-key", re.compile(r"(?i)aws[_.-]?secret[_.-]?(?:access[_.-]?)?key[\"'\s:=]+([A-Za-z0-9/+=]{40})")),
    ("github-token", re.compile(r"ghp_[A-Za-z0-9]{36,}")),
    ("github-fine", re.compile(r"github_pat_[A-Za-z0-9_]{82,}")),
    ("openai-key", re.compile(r"sk-[A-Za-z0-9]{20,}")),
    ("anthropic-key", re.compile(r"sk-ant-[A-Za-z0-9\-_]{20,}")),
    ("private-key", re.compile(r"-----BEGIN (?:RSA |EC |OPENSSH |DSA |PGP )?PRIVATE KEY-----")),
    ("slack-token", re.compile(r"xox[abposr]-[A-Za-z0-9-]{10,}")),
    ("stripe-key", re.compile(r"sk_live_[A-Za-z0-9]{24,}")),
    ("sendgrid-key", re.compile(r"SG\.[A-Za-z0-9_\-]{22,}\.[A-Za-z0-9_\-]{43,}")),
    ("generic-bearer", re.compile(r"(?i)bearer\s+[A-Za-z0-9_\-\.]{32,}")),
    ("jwt-token", re.compile(r"eyJ[A-Za-z0-9_\-]{10,}\.eyJ[A-Za-z0-9_\-]{10,}\.[A-Za-z0-9_\-]{10,}")),
    ("azure-storage-key", re.compile(r"DefaultEndpointsProtocol=https;AccountName=[^;]+;AccountKey=[A-Za-z0-9+/=]{88};")),  # ponytail: stricter via account-prefix whitelist, add when false-positive rate justifies
]


def scan_repo_secrets(repo: Path, cfg: dict[str, Any]) -> list[dict[str, str]]:
    """Walk repo and return non-redacted hits."""
    max_bytes = int(cfg["scan"].get("max_file_mb", 10)) * 1024 * 1024
    findings: list[dict[str, str]] = []
    ignore_globs = cfg["scan"].get("ignore_globs", [])

    def _ignored(p: Path) -> bool:
        rel = str(p.relative_to(repo))
        return any(Path(rel).match(g) for g in ignore_globs)

    for path in repo.rglob("*"):
        if not path.is_file():
            continue
        if _ignored(path):
            continue
        try:
            if path.stat().st_size > max_bytes:
                continue
            with path.open("rb") as f:
                data = f.read()
        except OSError:
            continue
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            continue
        for name, pat in SECRET_PATTERNS:
            if pat.search(text):
                findings.append({"repo": repo.name, "path": str(path.relative_to(repo)), "kind": name, "severity": "high"})
    return findings


# ---------- structure ----------

def scan_repo_structure(repo: Path, cfg: dict[str, Any]) -> list[dict[str, str]]:
    findings: list[dict[str, str]] = []
    if cfg["structure"].get("require_claudemd") and not (repo / "CLAUDE.md").exists():
        findings.append({"repo": repo.name, "kind": "missing-claudemd", "severity": "low"})
    readme = repo / "README.md"
    if not readme.exists() or readme.stat().st_size < int(cfg["structure"].get("min_readme_bytes", 100)):
        findings.append({"repo": repo.name, "kind": "thin-readme", "severity": "low"})
    return findings


def scan_empty_dirs(repos_dir: Path) -> list[str]:
    empties: list[str] = []
    for p in sorted(repos_dir.iterdir()):
        if not p.is_dir():
            continue
        has_content = any(child.name != ".git" for child in p.rglob("*"))
        if not has_content:
            empties.append(p.name)
    return empties


# ---------- sync ----------

def sync_repo(repo: Path) -> tuple[bool, str]:
    """git fetch + git merge --ff-only origin/HEAD. Returns (ok, message)."""
    try:
        subprocess.run(["git", "fetch", "--all", "--prune"], cwd=repo, check=True, timeout=120, capture_output=True)
    except subprocess.CalledProcessError as e:
        return False, f"fetch failed: {e.stderr.decode('utf-8','replace')[:200]}"
    try:
        # Determine default branch
        head = subprocess.check_output(["git", "symbolic-ref", "refs/remotes/origin/HEAD"], cwd=repo, text=True, timeout=10).strip()
        default_branch = head.rsplit("/", 1)[-1]
    except subprocess.CalledProcessError:
        default_branch = "main"
    try:
        subprocess.run(
            ["git", "merge", "--ff-only", f"origin/{default_branch}"],
            cwd=repo, check=True, timeout=60, capture_output=True,
        )
        return True, f"synced to origin/{default_branch}"
    except subprocess.CalledProcessError as e:
        return False, f"ff-merge failed (likely local commits): {e.stderr.decode('utf-8','replace')[:200]}"


# ---------- fix (safe-only) ----------

def apply_safe_fixes(repos_dir: Path, findings: list[dict[str, str]], cfg: dict[str, Any]) -> list[str]:
    """Non-breaking auto-fixes. Returns list of actions taken."""
    actions: list[str] = []
    if not cfg["auto_fix"].get("safe"):
        return actions
    # Prune empty dirs
    if cfg["auto_fix"].get("prune_empty_dirs"):
        for name in scan_empty_dirs(repos_dir):
            p = repos_dir / name
            try:
                shutil.rmtree(p)
                actions.append(f"pruned empty dir {p}")
            except OSError:
                actions.append(f"FAILED prune {p}")
    return actions


# ---------- channels ----------

def notify_ntfy(cfg: dict[str, Any], title: str, body: str, priority: str = "default") -> bool:
    n = cfg.get("channels", {}).get("ntfy", {})
    if not n.get("enabled") or not n.get("topic"):
        return False
    url = f"{n.get('server','https://ntfy.sh')}/{n['topic']}"
    req = urllib.request.Request(url, data=body.encode("utf-8"), method="POST")
    req.add_header("Title", title)
    req.add_header("Priority", priority)
    req.add_header("Tags", "vvb-projects")
    try:
        urllib.request.urlopen(req, timeout=10).read()
        return True
    except Exception:
        return False


def notify_telegram(cfg: dict[str, Any], body: str) -> bool:
    t = cfg.get("channels", {}).get("telegram", {})
    if not t.get("enabled") or not t.get("chat_id"):
        return False
    token = os.environ.get(t.get("bot_token_env", ""), "")
    if not token:
        return False
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    payload = json.dumps({"chat_id": t["chat_id"], "text": body}).encode("utf-8")
    req = urllib.request.Request(url, data=payload, method="POST")
    req.add_header("Content-Type", "application/json")
    try:
        urllib.request.urlopen(req, timeout=10).read()
        return True
    except Exception:
        return False


# ---------- report ----------

def build_report(cfg: dict[str, Any]) -> tuple[str, str]:
    host = socket.gethostname()
    repos = list_tracked_repos(cfg)
    title = f"vvb-projects [{host}] — {len(repos)} repos"
    lines = [f"host: {host}", f"repos: {len(repos)}", ""]
    secret_total = struct_total = 0
    for r in repos:
        s = scan_repo_secrets(r, cfg)
        struct = scan_repo_structure(r, cfg)
        secret_total += len(s)
        struct_total += len(struct)
        for f in s[:3]:
            lines.append(f"  SECRET [{f['kind']}] {r.name}/{f['path']}")
        for f in struct[:2]:
            lines.append(f"  STRUCT [{f['kind']}] {r.name}")
    lines.append("")
    lines.append(f"TOTAL secrets: {secret_total}")
    lines.append(f"TOTAL structural: {struct_total}")
    return title, "\n".join(lines)


# ---------- subcommands ----------

def cmd_sync(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    repos = list_tracked_repos(cfg)
    db = state_db_path(cfg)
    init_state(db)
    host = socket.gethostname()
    ok = bad = 0
    for r in repos:
        if args.repo and r.name != args.repo:
            continue
        success, msg = sync_repo(r)
        log_finding(db, host, "sync", "info" if success else "warn", r.name, "", msg)
        print(f"  {'OK' if success else 'FAIL'} {r.name}: {msg}")
        if success: ok += 1
        else: bad += 1
    summary = f"sync: {ok} ok, {bad} fail across {len(repos)} repos"
    print(summary)
    return 0 if bad == 0 else 1


def cmd_scan(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    repos = list_tracked_repos(cfg)
    db = state_db_path(cfg)
    init_state(db)
    host = socket.gethostname()
    total_secrets = 0
    for r in repos:
        if args.repo and r.name != args.repo:
            continue
        for f in scan_repo_secrets(r, cfg):
            log_finding(db, host, "secret", f["severity"], f["repo"], f["path"], f["kind"])
            print(f"  SECRET [{f['kind']}] {f['repo']}/{f['path']}")
            total_secrets += 1
    print(f"secrets found: {total_secrets}")
    return 1 if total_secrets > 0 else 0


def cmd_structure(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    repos = list_tracked_repos(cfg)
    repos_dir = Path(cfg["repos_dir"]).expanduser()
    findings = 0
    empties = scan_empty_dirs(repos_dir)
    if empties:
        print(f"empty dirs ({len(empties)}):")
        for e in empties:
            print(f"  - {e}")
        findings += len(empties)
    for r in repos:
        if args.repo and r.name != args.repo:
            continue
        for f in scan_repo_structure(r, cfg):
            print(f"  STRUCT [{f['kind']}] {f['repo']}")
            findings += 1
    print(f"structural findings: {findings}")
    return 0


def cmd_fix(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    repos_dir = Path(cfg["repos_dir"]).expanduser()
    all_findings: list[dict[str, str]] = []
    for r in list_tracked_repos(cfg):
        all_findings.extend(scan_repo_secrets(r, cfg))
        all_findings.extend(scan_repo_structure(r, cfg))
    actions = apply_safe_fixes(repos_dir, all_findings, cfg)
    if not actions:
        print("no safe fixes needed (or disabled in config)")
        return 0
    for a in actions:
        print(f"  {a}")
    print(f"applied {len(actions)} safe fix(es)")
    return 0


def cmd_report(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    title, body = build_report(cfg)
    print(f"=== {title} ===")
    print(body)
    if cfg["channels"]["ntfy"].get("enabled"):
        notify_ntfy(cfg, title, body, priority="default")
    if cfg["channels"]["telegram"].get("enabled"):
        notify_telegram(cfg, f"{title}\n\n{body}")
    return 0


def cmd_watch(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    interval = int(cfg.get("watch_interval_sec", 3600))
    print(f"vvb-projects watch on {socket.gethostname()} every {interval}s (Ctrl+C to stop)")
    while True:
        try:
            cmd_report(args, cfg)
        except Exception as e:
            print(f"loop error: {e}", file=sys.stderr)
        time.sleep(interval)


def cmd_config(args: argparse.Namespace, cfg: dict[str, Any]) -> int:
    if args.action == "show":
        print(json.dumps(cfg, indent=2, default=str))
    elif args.action == "validate":
        try:
            load_config(Path(args.path) if args.path else None)
            print("config OK")
            return 0
        except Exception as e:
            print(f"config INVALID: {e}")
            return 2
    return 0


# ---------- main ----------

def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(prog="vvb-projects", description=__doc__.splitlines()[0])
    p.add_argument("--config", type=Path, default=None, help="path to config.yaml")
    p.add_argument("--version", action="version", version=f"vvb-projects {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("sync", help="git fetch + ff-merge for every tracked repo").add_argument("--repo", default=None)
    sub.add_parser("scan", help="scan all repos for leaked secrets").add_argument("--repo", default=None)
    sub.add_parser("structure", help="find missing CLAUDE.md / empty dirs / thin READMEs").add_argument("--repo", default=None)
    sub.add_parser("fix", help="apply safe non-breaking fixes from config")
    sub.add_parser("report", help="single report -> NTFY/Telegram")
    sub.add_parser("watch", help="long-running report loop")

    pc = sub.add_parser("config", help="show or validate config")
    pc.add_argument("action", choices=["show", "validate"])
    pc.add_argument("--path", default=None)

    args = p.parse_args(argv)
    cfg = load_config(args.config)

    handlers = {
        "sync": cmd_sync, "scan": cmd_scan, "structure": cmd_structure,
        "fix": cmd_fix, "report": cmd_report, "watch": cmd_watch,
        "config": cmd_config,
    }
    return handlers[args.cmd](args, cfg)


if __name__ == "__main__":
    sys.exit(main())


